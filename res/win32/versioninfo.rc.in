1 VERSIONINFO
FILEVERSION     ${PROJECT_VERSION_MAJOR},${PROJECT_VERSION_MINOR},0,${NITRO_VERSION_REV}
PRODUCTVERSION  ${PROJECT_VERSION_MAJOR},${PROJECT_VERSION_MINOR},0,${NITRO_VERSION_REV}
FILEFLAGSMASK   0
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "04090000"
        BEGIN
            VALUE "CompanyName",      "The SolveSpace authors"
            VALUE "ProductName",      "SolveSpaceNitro"
            VALUE "ProductVersion",   "${SOLVESPACE_NITRO_DISPLAY_VERSION}"
            VALUE "FileDescription",  "SolveSpaceNitro, a parametric 2d/3d CAD"
            VALUE "FileVersion",      "${SOLVESPACE_NITRO_DISPLAY_VERSION}"
            VALUE "OriginalFilename", "solvespace.exe"
            VALUE "InternalName",     "solvespace"
            VALUE "LegalCopyright",   "(c) 2008-2026 Jonathan Westhues and other authors"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0
    END
END
